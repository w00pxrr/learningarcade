---
import Base from "../../layouts/Base.astro";
import { gamesData, gamesById } from "../../data/games";

export function getStaticPaths() {
  return gamesData.map((game) => ({
    params: { gameId: game.id },
  }));
}

const { gameId } = Astro.params;
const game = gameId ? gamesById[gameId] : null;

if (!game) {
  return Astro.redirect("/404");
}

const title = `${game.name} - Play Free Online | LearningArcade`;
const description = `Play ${game.name} online for free on LearningArcade. ${game.categories.join(", ")} game. Safe, school-friendly, and works on any device.`;
---

<Base title={title} description={description}>
  <div id="root" data-game-id={gameId}></div>
</Base>

<script>
  import { createRoot } from "react-dom/client";
  import ClientGamePage from "../../app/game/[gameId]/client";
  import React from "react";
  const container = document.getElementById("root");
  const gameId = container?.dataset.gameId;
  if (container && gameId) {
    createRoot(container).render(React.createElement(ClientGamePage, { gameId }));
  }
</script>